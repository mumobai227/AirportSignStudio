<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>3.25.1</Version>
    <StartupObject>AirportSignStudio.MainForm</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <Compile Include="src/*.cs" />
    <EmbeddedResource Include="assets/glyphs.xml" LogicalName="glyphs.xml" />
    <EmbeddedResource Include="assets/paint/reference.bin" LogicalName="paint.reference.bin" />
    <EmbeddedResource Include="docs/licenses/PdfPig.txt" LogicalName="licenses.PdfPig.txt" />
    <EmbeddedResource Include="assets/ocr/ch_PP-OCRv4_rec_mobile.onnx" LogicalName="ocr.stand.onnx" />
    <EmbeddedResource Include="docs/licenses/OCR-*.txt" />
  </ItemGroup>
  <Import Project="tools/OcrRuntime.targets" />
</Project>
